# Copy to .env.local and fill in real values. .env.local is gitignored.

# Postgres connection string.
DATABASE_URL="postgres://user:password@host:5432/postgres?sslmode=require"

# Port the HTTP/GraphQL server listens on.
PORT=3001

# Comma-separated list of origins allowed to open a Socket.IO connection.
SOCKET_CORS_ORIGINS="http://localhost:3000"

# RS256 keypair for signing/verifying access tokens, each base64-encoded PEM.
# Generate:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#   base64 -i private.pem | tr -d '\n'   # -> JWT_PRIVATE_KEY_BASE64
#   base64 -i public.pem  | tr -d '\n'   # -> JWT_PUBLIC_KEY_BASE64
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=

# Access token lifetime in seconds (optional, defaults to 3600).
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=3600

# Google OAuth client ID. Must match the client the frontend uses
# (frontend AUTH_GOOGLE_ID). Used to verify the audience of ID tokens
# sent to the loginWithGoogle mutation.
GOOGLE_CLIENT_ID=

# Set to "true" to enable the email-only devLogin mutation for local work.
# Ignored when NODE_ENV=production. Leave unset everywhere else.
DEV_AUTH_ENABLED=false
