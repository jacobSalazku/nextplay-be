generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String       @id @default(cuid())
  name               String?
  email              String       @unique
  emailVerified      DateTime?
  image              String?
  dateOfBirth        DateTime?
  phone              String?      @unique
  height             Float?
  weight             Float?
  dominantHand       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  hasOnBoarded       Boolean      @default(false)
  isBlocked          Boolean      @default(false)
  tokenVersion       Int          @default(1)
  createdTeamInvites TeamInvite[] @relation("TeamInviteCreator")
  members            Member[]
  refreshTokens      RefreshToken[]
  teams              Team[]       @relation("TeamCreator")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  familyId  String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  rotatedAt DateTime?
  revokedAt DateTime?

  @@index([userId])
  @@index([familyId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id                   String                @id @default(cuid())
  name                 String
  code                 String                @unique
  slug                 String
  shortId              String                @unique
  routeKey             String?               @unique
  ageGroup             String?
  image                String?
  creatorId            String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  activities           Activity[]
  gamePlans            GamePlan[]
  members              Member[]
  plays                Play[]
  practicePreparations PracticePreparation[]
  invites              TeamInvite[]
  creator              User                  @relation("TeamCreator", fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([slug])
}

model Member {
  id          String                     @id @default(cuid())
  userId      String
  teamId      String
  role        Role
  status      Status
  number      String?
  position    String?
  team        Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances PlayerActivityAttendance[]
  statlines   Statline[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @default(now()) @updatedAt

  @@unique([userId, teamId])
  @@index([teamId])
}

model TeamInvite {
  id        String    @id @default(cuid())
  token     String    @unique
  teamId    String
  expiresAt DateTime
  maxUses   Int       @default(1)
  usedCount Int       @default(0)
  revokedAt DateTime?
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  creator   User      @relation("TeamInviteCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([createdBy])
  @@index([expiresAt])
}

model Activity {
  id        String                     @id @default(cuid())
  title     String
  time      String
  type      ActivityType
  duration  Float?
  date      DateTime
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @updatedAt
  teamId    String
  team      Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  feedback  Feedback?
  film      Film?
  game      Game?
  meeting   Meeting?
  attendees PlayerActivityAttendance[]
  practice  Practice?
}

model Game {
  activityId        String            @id
  location          Location
  activity          Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  gameplan          GamePlan?
  opponentStatlines OpponentStatline?
  statlines         Statline[]
}

model Practice {
  activityId   String                @id
  facility     String
  practicetype PracticeType
  activity     Activity              @relation(fields: [activityId], references: [id], onDelete: Cascade)
  preparation  PracticePreparation[]
}

model Film {
  activityId String   @id
  notes      String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Meeting {
  activityId String   @id
  notes      String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Feedback {
  activityId String   @id
  coach      String
  notes      String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Statline {
  id                  String   @id @default(cuid())
  fieldGoalsMade      Int
  fieldGoalsMissed    Int
  threePointersMade   Int
  threePointersMissed Int
  freeThrows          Int
  freeThrowsMissed    Int
  assists             Int
  steals              Int
  turnovers           Int
  offensiveRebounds   Int      @default(0)
  defensiveRebounds   Int      @default(0)
  blocks              Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  gameId              String
  memberId            String
  Game                Game     @relation(fields: [gameId], references: [activityId], onDelete: Cascade)
  Member              Member   @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([memberId, gameId], name: "memberId_gameId")
}

model PlayerActivityAttendance {
  id               String           @id @default(cuid())
  activityId       String
  memberId         String
  attendanceStatus AttendanceStatus
  reason           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  activity         Activity         @relation(fields: [activityId], references: [id], onDelete: Cascade)
  member           Member           @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([activityId, memberId])
  @@index([activityId])
  @@index([memberId])
}

model OpponentStatline {
  id                String   @id @default(cuid())
  name              String
  gameId            String   @unique
  fieldGoalsMade    Int      @default(0)
  threePointersMade Int      @default(0)
  freeThrowsMade    Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  game              Game     @relation(fields: [gameId], references: [activityId], onDelete: Cascade)
}

model Play {
  id          String                @id @default(cuid())
  teamId      String
  name        String
  category    Category
  description String
  canvas      String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  team        Team                  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  gamePlans   GamePlan[]            @relation("GamePlanPlays")
  practices   PracticePreparation[] @relation("PracticePlays")

  @@index([teamId])
}

model GamePlan {
  id        String   @id @default(cuid())
  gameID    String   @unique
  teamId    String
  title     String
  opponent  String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  game      Game     @relation(fields: [gameID], references: [activityId], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  plays     Play[]   @relation("GamePlanPlays")
}

model PracticePreparation {
  id         String    @id @default(cuid())
  practiceId String?
  teamId     String
  name       String
  focus      String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  practice   Practice? @relation(fields: [practiceId], references: [activityId], onDelete: Cascade)
  team       Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  plays      Play[]    @relation("PracticePlays")
}

enum ActivityType {
  GAME
  PRACTICE
  FILM
  FEEDBACK
  MEETING
}

enum Role {
  COACH
  PLAYER
}

enum Status {
  ACTIVE
  PENDING
  INACTIVE
  REMOVED
}

enum AttendanceStatus {
  ATTENDING
  NOT_ATTENDING
  LATE
}

enum PracticeType {
  TEAM
  SPECIALISATION
  PHYSICAL
  SHOOTING
}

enum Location {
  HOME
  AWAY
}

enum Category {
  OFFENSIVE
  DEFENSIVE
  SPECIAL
}
